---
import Image from "astro/components/Image.astro";
const { projectName } = Astro.props;
const allProductImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/projects/*.{jpeg,jpg,gif,png}",
);
const displayImages = Object.keys(allProductImages).filter((image) =>
  image.includes(projectName),
);
---

<!-- Image Gallery -->
<div class="imageGrid" style=`--image-total: ${displayImages.length};`>
  {
    displayImages.length &&
      allProductImages &&
      displayImages.map((imagePath) => (
        <div class="imageContainer">
          <Image src={allProductImages[imagePath]()} alt="" data-lightbox />
        </div>
      ))
  }
</div>

<style>
  .imageGrid {
    display: grid;
    grid-template-columns: repeat(var(--image-total), minmax(260px, 1fr));
    gap: 2.4rem;
    width: 100%;
    max-width: 100%;
    overflow-x: scroll;

    @media (min-width: 768px) {
      grid-template-columns: 1fr;
      overflow: hidden;
    }
  }

  .imageContainer {
    width: 100%;

    img {
      width: 100%;
      max-width: 100%;
      height: auto;
    }
  }
</style>

<script>
  class Lightbox {
    lightbox: HTMLElement | null;
    image: HTMLImageElement | null;
    images: NodeListOf<HTMLImageElement> | null;
    currentIndex: number;

    constructor() {
      this.lightbox = document.getElementById("lightbox");
      this.image = document.getElementById(
        "lightbox-img",
      ) as HTMLImageElement | null;
      this.images = [...document.querySelectorAll("[data-lightbox]")];
      this.currentIndex = 0;

      this.init();
    }

    init() {
      // Click on gallery images
      this.images?.forEach((img, index) => {
        img.addEventListener("click", () => this.open(index));
        img.style.cursor = "pointer";
      });

      // Control buttons
      this.lightbox
        ?.querySelector(".lightbox-close")
        ?.addEventListener("click", () => this.close());
      this.lightbox
        ?.querySelector(".lightbox-prev")
        ?.addEventListener("click", () => this.prev());
      this.lightbox
        ?.querySelector(".lightbox-next")
        ?.addEventListener("click", () => this.next());

      // Close by clicking the background
      this.lightbox?.addEventListener("click", (e) => {
        if (e.target === this.lightbox) this.close();
      });

      // Keyboard navigation
      document.addEventListener("keydown", (e) => this.handleKeyboard(e));
    }

    open(index: number) {
      this.currentIndex = index;
      this.updateImage();
      this.lightbox?.classList.add("active");
      document.body.style.overflow = "hidden";
    }

    close() {
      this.lightbox?.classList.remove("active");
      document.body.style.overflow = "";
    }

    prev() {
      if (this.images) {
        this.currentIndex =
          (this.currentIndex - 1 + this.images.length) % this.images.length;
        this.updateImage();
      }
    }

    next() {
      if (this.images) {
        this.currentIndex = (this.currentIndex + 1) % this.images.length;
        this.updateImage();
      }
    }

    updateImage() {
      const img = this.images?.[this.currentIndex];
      if (img && this.image) {
        this.image.src = img?.src;
        this.image.alt = img?.alt;
      }

      // Update counter
      const currentEl = document.getElementById("current");
      if (currentEl) {
        currentEl.textContent = (this.currentIndex + 1).toString();
      }
      const totalEl = document.getElementById("total");
      if (totalEl && this.images) {
        totalEl.textContent = this.images.length.toString();
      }
    }

    handleKeyboard(e: KeyboardEvent) {
      if (!this.lightbox?.classList.contains("active")) return;

      switch (e.key) {
        case "Escape":
          this.close();
          break;
        case "ArrowLeft":
          this.prev();
          break;
        case "ArrowRight":
          this.next();
          break;
      }
    }
  }

  // Initialisation
  new Lightbox();
</script>
